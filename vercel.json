{
  "version": 2,
  "functions": {
    "api/claude.js": {
      "runtime": "edge"
    }
  },
  "routes": [
    {
      "src": "/api/claude",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://mk-work-ai.github.io",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "continue": true
    },
    {
      "src": "/api/claude",
      "dest": "/api/claude.js"
    }
  ]
}
